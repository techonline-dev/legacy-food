<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule \.(php|phtml|phar|php3|php4|php5|php7|phps|cgi|pl|py|sh)$ - [F,L]
</IfModule>

<FilesMatch "\.(php|phtml|phar|php3|php4|php5|php7|phps|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
