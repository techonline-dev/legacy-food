APP_NAME="Legacy Food"
APP_ENV=local
APP_DEBUG=true
APP_URL="http://legacyfood.test"
APP_LOCAL_URL="http://legacyfood.test"
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# Used to sign guest cart cookies. Falls back to INSTALL_KEY when empty.
APP_KEY=

# ========================================================
# DATABASE TARGET SELECTOR
# Options:
#  'local'      -> Force local MySQL database (Laragon / XAMPP)
#  'production' -> Force production MySQL database (Hostinger Cloud)
# Selection is explicit; the application never guesses from the Host header.
# ========================================================
DB_TARGET=local
DB_AUTO_CREATE=false
DB_AUTO_MIGRATE=false

# ========================================================
# LOCAL DATABASE CONFIGURATION (Laragon / XAMPP / Localhost)
# ========================================================
DB_LOCAL_HOST=127.0.0.1
DB_LOCAL_PORT=3306
DB_LOCAL_DATABASE=legacyfood
DB_LOCAL_USERNAME=root
DB_LOCAL_PASSWORD=
DB_LOCAL_CHARSET=utf8mb4

# ========================================================
# PRODUCTION DATABASE CONFIGURATION (Live Server)
# ========================================================
DB_PROD_HOST=localhost
DB_PROD_PORT=3306
DB_PROD_DATABASE=u291611210_legacyfood
DB_PROD_USERNAME=u291611210_legacyfood
DB_PROD_PASSWORD=
DB_PROD_CHARSET=utf8mb4

# Legacy Fallback Variables (kept for backward compatibility)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=legacyfood
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Mail Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@legacyfood.in"
MAIL_FROM_NAME="Legacy Food"

# Payment Gateways (Leave blank to use Demo / Test Simulation mode or enter real keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_DEMO=true

# Admin bootstrap (only used by scripts/create-admin.php)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Installer protection (required when APP_ENV=production).
# Generate a long random value before deploying; an empty key disables the installer in production.
INSTALL_KEY=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Business & Support
WHATSAPP_NUMBER=919845279936
CONTACT_EMAIL=contact@legacyfood.in
CONTACT_PHONE="+91 81234 50509"
SUPPORT_HOURS="Mon - Sat: 9:00 AM - 7:00 PM IST"
