APP_NAME="Legacy Food"
APP_ENV=local
APP_DEBUG=true
APP_URL="https://lensinteractive.com/legacyfood"
APP_LOCAL_URL="http://legacyfood.test"

# ========================================================
# DATABASE TARGET SELECTOR
# Options:
#  'auto'       -> Automatically uses local DB on localhost / .test / 127.0.0.1,
#                  and uses production DB on live domain (lensinteractive.com)
#  'local'      -> Force local MySQL database (Laragon / XAMPP)
#  'production' -> Force production MySQL database (Hostinger Cloud)
# ========================================================
DB_TARGET=auto

# ========================================================
# LOCAL DATABASE CONFIGURATION (Laragon / XAMPP / Localhost)
# ========================================================
DB_LOCAL_HOST=127.0.0.1
DB_LOCAL_PORT=3306
DB_LOCAL_DATABASE=legacyfood
DB_LOCAL_USERNAME=root
DB_LOCAL_PASSWORD=
DB_LOCAL_CHARSET=utf8mb4

# ========================================================
# PRODUCTION DATABASE CONFIGURATION (Live Server)
# ========================================================
